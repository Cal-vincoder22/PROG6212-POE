@model List<RaceDay.Web.Models.OrganiserEventItem>
@{ ViewData["Title"] = "Organiser dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My events</h2>
    <a asp-action="Create" class="btn btn-rd">+ New event</a>
</div>

@if (!Model.Any())
{
    <div class="rd-panel text-center text-muted">You haven't created any events yet.</div>
}
else
{
    <div class="rd-panel">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th></th><th>Event</th><th>Date</th><th>Type</th><th>Entries</th><th>Banner</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td style="width:70px">
                            @if (!string.IsNullOrEmpty(e.BannerImageUrl))
                            { <img src="@e.BannerImageUrl" alt="" style="width:64px;height:44px;object-fit:cover;border-radius:6px;" /> }
                        </td>
                        <td><strong>@e.Name</strong><br /><span class="text-muted small">@e.Location</span></td>
                        <td>@e.EventDate.ToString("d MMM yyyy")</td>
                        <td><span class="badge type-badge type-@e.EventType.ToLower()">@e.EventType</span></td>
                        <td>@e.EnrolmentCount</td>
                        <td>
                            <form asp-action="UploadBanner" method="post" enctype="multipart/form-data" class="d-flex gap-1">
                                <input type="hidden" name="id" value="@e.EventId" />
                                <input type="file" name="file" accept="image/jpeg,image/png,image/webp" class="form-control form-control-sm" />
                                <button class="btn btn-outline-rd btn-sm" type="submit">Upload</button>
                            </form>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Categories" asp-route-id="@e.EventId" class="btn btn-outline-rd btn-sm">Categories</a>
                            <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-outline-rd btn-sm">Entries</a>
                            <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-outline-rd btn-sm">Edit</a>
                            <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}