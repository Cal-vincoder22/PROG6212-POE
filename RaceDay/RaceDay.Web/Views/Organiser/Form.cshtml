@model RaceDay.Web.Models.EventFormModel
@{
    var editing = Model.EventId > 0;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="rd-panel" style="max-width:720px;">
    <form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.EventId : (int?)null)">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option>Run</option>
                    <option>Walk</option>
                    <option>Cycle</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-rd">@(editing ? "Save changes" : "Create event")</button>
        <a asp-action="Index" class="btn btn-outline-rd ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}