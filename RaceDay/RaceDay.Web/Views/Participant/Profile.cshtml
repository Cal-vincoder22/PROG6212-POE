@model RaceDay.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<h2 class="mb-3">My profile</h2>

<div class="row g-4">
    <div class="col-md-4">
        <div class="rd-panel text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile picture" class="rd-avatar mx-auto mb-3" />
            }
            else
            {
                <div class="rd-avatar mx-auto mb-3">@(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?")</div>
            }
            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data">
                <input type="file" name="file" accept="image/jpeg,image/png,image/webp" class="form-control mb-2" />
                <button type="submit" class="btn btn-outline-rd btn-sm w-100">Upload picture</button>
            </form>
            <p class="text-muted small mt-2 mb-0">JPEG, PNG or WebP, up to 5 MB.</p>
        </div>
    </div>
    <div class="col-md-8">
        <div class="rd-panel">
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input value="@Model.Email" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label">Role</label>
                    <input value="@Model.Role" class="form-control" disabled />
                </div>
                <button type="submit" class="btn btn-rd">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}