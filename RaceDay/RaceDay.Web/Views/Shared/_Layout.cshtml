@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("FullName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" href="/">RACE<span>DAY</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav"
                        aria-controls="rdNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="rdNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/">Events</a></li>
                        @if (role == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link" href="/Organiser/Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Organiser/Events">Manage events</a></li>
                        }
                        @if (role == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link" href="/Participant/MyEvents">My events</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Participant/MyResults">My results</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Participant/Profile">Profile</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (role != null)
                        {
                            <li class="nav-item me-lg-3 text-white-50">
                                @name <span class="badge rd-role-badge">@role</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/Account/Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-rd btn-sm" href="/Account/Register">Sign up</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">&copy; 2026 RaceDay. Run it. Walk it. Ride it.</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>